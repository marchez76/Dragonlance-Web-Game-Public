# ==========================================================================
# ESCLUSIONI DEL REPOSITORY PUBBLICO
#
# La regola generale e' semplice: qui dentro va cio' che abbiamo SCRITTO NOI —
# documenti, script, schemi, decisioni. Non va nulla che sia TRASCRIZIONE di
# un manuale.
#
# Le esclusioni sono elencate una per una, con il motivo. Preferisco una lista
# lunga a una regola breve: cosi' se un giorno una cartella nuova non e'
# coperta, se ne accorge chi legge invece che nessuno.
# ==========================================================================

# --------------------------------------------------------------------------
# FONTI E TESTI ESTRATTI
# I PDF dei manuali e tutto cio' che ne deriva per estrazione diretta.
# Marco ne possiede copia fisica: l'uso e' personale, la ridistribuzione no.
# --------------------------------------------------------------------------
Manuali/
Testi/
Estratti/

# --------------------------------------------------------------------------
# DATI DI GIOCO
# Ogni JSON in queste cartelle contiene `source_2e`, che per costruzione e'
# trascrizione fedele del manuale — requisiti, tabelle di avanzamento, testi
# delle capacita', statblock. E' la fedelta' che lo rende utile al progetto,
# ed e' la stessa fedelta' che lo rende non pubblicabile.
#
# Lo strato `mechanics_5e` sarebbe nostro, ma vive nello stesso file: non si
# possono separare senza spezzare lo schema a due strati. Quindi esce tutto.
# --------------------------------------------------------------------------
dati/razze/
dati/classi/
dati/divinita/
dati/mostri/
dati/oggetti/
# Modelli applicabili a un ospite (decisione 38): dreamshadow, spectral-minion,
# dreamwraith. Stesso motivo delle cartelle sopra — ogni file porta `source_2e`
# con il blocco statistiche trascritto e le capacita' citate dalla fonte. La
# cartella e' esclusa qui NELLO STESSO COMMIT che ha creato il primo file, e
# aggiunta a PERCORSI in git-privato.sh nello stesso momento: e' la regola di
# CLAUDE.md 1, applicata alla nascita e non a posteriori come per dati/oggetti/.
dati/modelli/
dati/*.index.json

# Moduli e dati di trascrizione: contengono i testi 2e verbatim.
dati/_tratti_phb2e.py
dati/_tratti_mc.py
dati/_draconici.py
dati/_fonti/progressioni_2e.json
dati/_fonti/incantesimi_2e.json
# Sfere, poteri concessi e scacciare non morti delle 21 divinita', trascritti
# parola per parola dal capitolo Realms Above.
dati/_fonti/divinita_2e.json

# Le build che li generano leggono i testi estratti e li incorporano.
dati/build_razze.py
dati/build_classi.py
dati/build_divinita.py
dati/_strato5e.py

# --------------------------------------------------------------------------
# MATERIALE ESTERNO
# Respinto dalla decisione 26 perche' non tracciabile. Non va da nessuna
# parte, tantomeno in un repository pubblico.
# --------------------------------------------------------------------------
import/

# Consultazione 3.5: materiale di terzi, statuto di riscontro.
riscontro/

# --------------------------------------------------------------------------
# ALTRO MATERIALE NON NOSTRO
# --------------------------------------------------------------------------
Musica/

# Inventario dei PDF posseduti: e' l'indice della libreria privata, sta con
# lei e non qui.
inventario_manuali.tsv

# --------------------------------------------------------------------------
# IL SECONDO REPOSITORY
# .git-private/ e' un secondo repository git (dati/ con source_2e) che vive
# nella stessa cartella di lavoro. Senza questa esclusione un `git add -A`
# nel pubblico ne traccia gli interni — index, HEAD, oggetti — dentro la
# cronologia pubblica. E' successo una volta: la correzione e' qui.
# --------------------------------------------------------------------------
.git-private/

# --------------------------------------------------------------------------
# STATO DI LAVORO E TEMPORANEI
# --------------------------------------------------------------------------
.colstep_state/
.ocr_state/
ocr_queue.txt
__pycache__/
*.pyc
.DS_Store
*.tmp
*.part

# Note valide solo su questa macchina: percorsi locali, promemoria di
# ambiente. CLAUDE.md (le regole di progetto) resta pubblico.
CLAUDE.local.md

# --------------------------------------------------------------------------
# ECCEZIONI — file che restano NONOSTANTE le regole sopra.
# Sono nostri o derivano dall'SRD 5.1, che e' CC-BY e ridistribuibile con
# attribuzione (vedi LICENSE-SRD.md).
# --------------------------------------------------------------------------
!dati/schema/
!dati/schema/*.json
!dati/_srd51.py
!dati/_sfere_5e.py
!dati/_fonti/srd51_mostri.py
!dati/_chassis_5e.py
!dati/_campi_2e.py
!dati/_criterio_fonti.py
!dati/_divergenze_sotdq.py
!dati/_nomi_verificati.py
!dati/_bestiario_mc.py
!dati/analizza_classi.py
!dati/analizza_bestiario.py
!dati/analizza_personaggio.py
!dati/confronta_mostri.py
!dati/verifica_sfere.py
!dati/valida.py
!dati/valida_classi.py
!dati/valida_divinita.py
!dati/valida_mostri.py
!dati/valida_modelli.py
!dati/RAPPORTO-*.md
!dati/DOSSIER-*.md

# Equipaggiamento ordinario (Fase 2): estratto dall'SRD 5.1 via
# api.open5e.com, non da un manuale 2e — nessun testo di manuale in questi
# tre file. dati/oggetti/ resta comunque escluso (regola sopra): contiene
# anche il diadema, scritto a mano con source_2e dell'MC Appendix.
!dati/_fonti/srd51_equipaggiamento.py
!dati/build_oggetti.py
!dati/valida_oggetti.py

# Pacchetti ed equipaggiamento iniziale di classe (05/09/2026): stessa fonte
# e stessa ragione dei tre file qui sopra — SRD 5.1 via api.open5e.com, la
# sezione «Equipment Packs» e il campo `equipment` delle classi SRD. Nessun
# testo 2e. Il rapporto che li usa legge dati/classi/ e dati/oggetti/, che
# sono privati, e non ne riproduce niente: stampa conteggi, id e nomi di
# voci SRD, e delle regole di equipaggiamento della fonte dice QUANTE sono,
# non quali. Dichiarato qui nello stesso commit che crea i file.
!dati/_fonti/srd51_pacchetti.py
!dati/analizza_equipaggiamento.py

# Pacchetti di equipaggiamento iniziale (05/09/2026, decisione 62,
# `pacchetto-fisso`). CARTELLA NUOVA SOTTO dati/, quindi la sua sorte si
# dichiara ADESSO e non quando qualcuno se ne accorge (CLAUDE.md 1). Resta
# PUBBLICA, e la ragione e' la stessa di dati/condizioni/ e
# dati/incantesimi/: viene dall'SRD 5.1 (CC-BY, LICENSE-SRD.md) e non porta
# source_2e — lo schema non ne prevede uno, perche' i pacchetti sono un
# istituto della 5e e la fonte 2e per l'equipaggiamento iniziale e' una
# formula di ricchezza che la decisione 62 lascia non applicata. Un pacchetto
# e' un elenco di RIFERIMENTI a dati/oggetti/, non una copia: i nomi delle
# voci SRD ci sono, il testo dei manuali no. NON va in PERCORSI di
# git-privato.sh. Se un giorno servisse un pacchetto proprio di Krynn preso
# da un manuale, quello sara' il momento di rileggere questa riga.
!dati/pacchetti/
!dati/pacchetti/*.json
!dati/build_pacchetti.py
!dati/valida_pacchetti.py

# Allineamento (05/09/2026): il vocabolario dei nove viene dalla sezione
# Alignment dell'SRD 5.1, la lettura delle restrizioni di classe e' nostra.
# Il modulo legge dati/classi/, dati/mostri/ e dati/divinita/ — privati — e
# non ne riproduce il testo: porta la frase breve da cui ogni insieme e'
# stato letto, che e' un dato di regola e non prosa di manuale, e la tiene
# li' perche' la lettura sia verificabile senza aprire il file privato.
!dati/_allineamenti.py

# Lista incantesimi (Fase 2): stessa ragione dell'equipaggiamento sopra, ma
# qui la cartella intera puo' restare pubblica, non solo i tre script — a
# differenza di dati/oggetti/, dati/incantesimi/ non condivide spazio con
# nessun caso a source_2e (incantesimo.schema.json non ne ha uno). Se un
# giorno un incantesimo di Dragonlance senza equivalente SRD lo richiedesse,
# quello sarebbe il momento di aggiungere qui un'esclusione, non prima.
!dati/_fonti/srd51_incantesimi.py
!dati/build_incantesimi.py
!dati/valida_incantesimi.py
!dati/incantesimi/
!dati/incantesimi/*.json
!dati/incantesimi.index.json

# Condizioni della 5e (Fase 2): stessa posizione di dati/incantesimi/ sopra,
# stessa ragione. Vengono dall'Appendice A dell'SRD 5.1, CC-BY: nessun testo
# 2e, nessun source_2e — condizione.schema.json non ne prevede uno, e la
# prosa italiana e' nostra. La decisione e' scritta QUI, nello stesso commit
# che ha creato il primo file, invece di essere lasciata al fatto che nessuna
# regola sopra le catturi: e' la differenza fra una cartella pubblica per
# scelta e una pubblica per distrazione, ed e' il senso della regola di
# CLAUDE.md 1. Non vanno in PERCORSI di git-privato.sh: il doppio
# tracciamento e' la trappola documentata li'. Se un giorno servisse una
# condizione propria di Krynn, con testo di manuale, quello sara' il momento
# di rivedere questa scelta, non prima.
!dati/build_condizioni.py
!dati/valida_condizioni.py
!dati/condizioni/
!dati/condizioni/*.json

# Dati di sistema (decisione 51, `criterio-meccanica`): le tabelle che la 5e
# stampa uguali per ogni creatura — modificatore di caratteristica, bonus di
# competenza, moltiplicatori delle difese, soglie del d20, generazione delle
# caratteristiche. Stessa posizione e stessa ragione di dati/condizioni/
# sopra: nessun testo di manuale e nessun source_2e (sistema.schema.json non
# ne prevede uno). Dichiarato QUI nello stesso commit che crea il primo file,
# non a posteriori. Non va in PERCORSI di git-privato.sh.
#
# LA RILETTURA CHIESTA DA QUESTA RIGA STESSA, fatta il 05/09/2026. La versione
# precedente diceva: «vengono dall'SRD 5.1, CC-BY [...] `source_edition` e'
# costante a "SRD 5.1"», e chiudeva con «se un giorno servisse una tabella
# presa da un manuale, quello sara' il momento di rivedere questa scelta».
# Quel giorno e' arrivato con `sistema/generazione-caratteristiche.json`: le
# sezioni dell'SRD 5.1 non contengono la generazione delle caratteristiche —
# ne' 4d6 scarta il minore, ne' l'array standard, ne' il listino
# dell'acquisto a punti — che vengono dal PHB 2014 della decisione 2
# (`edizione-phb-2014`).
#
# La cartella resta pubblica, e il criterio non cambia: e' quello di
# CLAUDE.md 1 — «questo file riproduce testo dei manuali?». No: sei numeri,
# una tabella di otto righe e prosa italiana nostra sono la regola in fatti,
# non nella forma del manuale. La costante "SRD 5.1" nello schema non era il
# criterio, era una COINCIDENZA di cio' che era stato aggiunto fin li', ed e'
# ora un enum che dichiara la fonte file per file. Non cambia nemmeno cosa e'
# gia' pubblico: quegli stessi numeri stanno da sempre in
# `motore/generazione.py`, che e' tracciato dal pubblico. Cio' che questa
# rilettura NON autorizza e' un testo di manuale in un `mechanics_5e` di
# questa cartella: quella prosa resta nostra, e la `note` del JSON lo dice.
!dati/_sistema.py
!dati/valida_sistema.py
!dati/sistema/
!dati/sistema/*.json
!dati/schema/sistema.schema.json

# Confronto fra i due strati (source_2e contro mechanics_5e) e validatore
# degli effetti strutturati: codice nostro, nessun testo di fonte. Leggono i
# dati privati e non ne riproducono niente — stampano solo divergenze.
!dati/verifica_strati.py
!dati/valida_effetti.py
!dati/schema/effetto.schema.json
!dati/schema/condizione.schema.json

# --------------------------------------------------------------------------
# ECCEZIONE DENTRO L'ECCEZIONE — le versioni "completo" dei RAPPORTO-*.md.
# Alcuni generatori (analizza_bestiario.py, verifica_sfere.py,
# analizza_classi.py) producono DUE uscite dalla stessa analisi: una
# ridotta (pubblica, sopra) e una completa con il testo di fonte per
# riferimento interno. La completa non deve mai finire qui, altrimenti la
# riduzione e' cosmetica: la stessa ragione di dati/_draconici.py.
# --------------------------------------------------------------------------
dati/RAPPORTO-*-completo.md
